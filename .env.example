# Copy to .env locally. Do not commit real credentials.
# SafeOps never reads hardcoded secrets; the AWS SDK uses the standard chain.

# Amazon Bedrock (generative diagnosis only; incurs AWS usage if you run the live agent)
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Official Strands Decider local server (examples/strands default)
STRANDS_DECIDER_URL=http://127.0.0.1:8099

# Optional override of the Bedrock model id used by the official example
# SAFEOPS_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional path override for synthetic incidents catalog
# SAFEOPS_DATA_PATH=data/incidents.json
